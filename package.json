{
  "name": "brightvale-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "validate:production-subpath": "node scripts/validate-production-subpath.mjs",
    "test:production-subpath": "node --test tests/production-subpath.test.mjs",
    "export:brightvale-city": "node assets/authoring/brightvale-city/export-production.mjs",
    "test:brightvale-city:export": "node --test assets/authoring/brightvale-city/compress-glb.test.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:brightvale:browser": "node --test tests/browser/brightvale/responsive.test.mjs tests/browser/brightvale/acceptance-plan.test.mjs tests/browser/brightvale/cli.test.mjs && node tests/browser/brightvale/cli.mjs",
    "test:brightvale:favorites": "node --test tests/browser/brightvale/favorites-toggle.browser.mjs",
    "test:brightvale:ratings": "node --test tests/browser/brightvale/observatory-ratings.browser.mjs",
    "test:brightvale:acceptance": "node tests/browser/brightvale/observatory-acceptance.mjs smoke",
    "test:brightvale:acceptance:exhaustive": "node tests/browser/brightvale/observatory-acceptance.mjs exhaustive",
    "chart:generate": "python3 scripts/beat_chart.py --all",
    "chart:check": "python3 scripts/beat_chart.py --check --all",
    "test:chart": "python3 -m unittest tests/test_beat_chart.py tests/test_beat_chart_workflow.py tests/test_beat_chart_migration.py tests/test_pitch_lanes.py tests/test_pitch_chart_workflow.py tests/test_pitch_experiment.py tests/test_chart_density.py tests/test_tune_song.py",
    "lint": "eslint .",
    "format": "prettier --write package.json package-lock.json tsconfig.json vite.config.ts eslint.config.js .prettierrc.json index.html 'src/**/*.{ts,css}' README.md",
    "format:check": "prettier --check package.json package-lock.json tsconfig.json vite.config.ts eslint.config.js .prettierrc.json index.html 'src/**/*.{ts,css}' README.md"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.4",
    "@types/three": "0.186.0",
    "eslint": "10.12.0",
    "meshoptimizer": "1.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
