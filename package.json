{
  "name": "brightvale-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:brightvale:browser": "node --test tests/browser/brightvale/responsive.test.mjs && node tests/browser/brightvale/cli.mjs",
    "chart:generate": "python3 scripts/beat_chart.py",
    "chart:check": "python3 scripts/beat_chart.py --check",
    "test:chart": "python3 -m unittest tests/test_beat_chart.py tests/test_beat_chart_workflow.py",
    "lint": "eslint .",
    "format": "prettier --write package.json package-lock.json tsconfig.json vite.config.ts eslint.config.js .prettierrc.json index.html 'src/**/*.{ts,css}' README.md",
    "format:check": "prettier --check package.json package-lock.json tsconfig.json vite.config.ts eslint.config.js .prettierrc.json index.html 'src/**/*.{ts,css}' README.md"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.4",
    "@types/three": "0.186.0",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
